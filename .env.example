# Metricool API credentials, used only by scripts/fetch-metricool.mjs.
# Get these from Metricool > Configuración > Perfil > API.
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=

# Metricool brand/blog id for the ripwallet.cr account. Optional — defaults
# to 6866306 if unset.
METRICOOL_BLOG_ID=6866306

# Notion internal integration secret, used only by scripts/fetch-notion.mjs.
# Create at https://www.notion.so/my-integrations, then share it with the
# "Asesorías" and "Inversiones" databases in Notion (··· menu > Connections).
NOTION_TOKEN=
