---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import kevinImg from "../images/kevin.jpg";
import johannaImg from "../images/johanna.jpg";
import jostinImg from "../images/jostin_final.jpg";
import eduardoImg from "../images/eduardo.jpeg";
import josephImg from "../images/joseph.jpg";
import brandonImg from "../images/brandon.jpg";
import joselynImg from "../images/joselyn.jpg";

type TeamMember = {
  img: ImageMetadata;
  alt: string;
  name: string;
  accent: string;
  tags: string[];
  eyebrow: string;
  bio: string;
  delay: string;
  imgPosition?: string;
};

const team: TeamMember[] = [
  {
    img: kevinImg,
    alt: "Kevin",
    name: "Kevin",
    accent: "yellow",
    tags: ["Fundador", "Asesor"],
    // Broma pendiente: si activamos el carrusel de tags, Kevin lleva todos los sombreros:
    // tags: ["Fundador", "Asesor", "Operaciones", "Editor de video", "Escritor", "Community Manager"],
    eyebrow: "Catador de hamburguesas",
    bio: "El fundador de RIP Wallet y el que sale en los videos. Me encanta salir a comer, armar legos y compartir con los demás.",
    delay: "delay-1",
  },
  {
    img: johannaImg,
    alt: "Perfil de Johanna",
    name: "Johanna",
    accent: "pink",
    tags: ["Operaciones"],
    eyebrow: "Ex ordenada-desordenada",
    bio: "Soy project manager desde hace seis años y he trabajado para varias transnacionales. Me gusta mucho comprar ropa e ir al gym.",
    delay: "delay-2",
  },
  {
    img: joselynImg,
    alt: "Perfil de Joselyn",
    name: "Joselyn",
    accent: "orange",
    tags: ["Operaciones"],
    eyebrow: "La más aplicada",
    bio: "Soy ingeniera en mecatrónica y siempre me preocupo por seguir el presupuesto. Me gusta salir a comer y comprar cafés en Starbucks.",
    delay: "delay-3",
  },
  {
    img: jostinImg,
    alt: "Perfil de Jostin",
    name: "Jostin",
    accent: "red",
    tags: ["Asesor"],
    eyebrow: "Siempre usa gorra",
    bio: "Soy Administrador de Empresas con experiencia en procesos de administración y logística. Me gustan las motos y salir a comer.",
    delay: "delay-4",
  },
  {
    img: eduardoImg,
    alt: "Perfil de Eduardo",
    name: "Eduardo",
    accent: "blue",
    tags: ["Asesor"],
    eyebrow: "Fiebre del gym",
    bio: "Soy ingeniero industrial, amante de los números y del presupuesto. Me gusta la naturaleza, hacer ejercicio y gastar en salidas a comer.",
    delay: "delay-5",
  },
  {
    img: josephImg,
    alt: "Perfil de Joseph",
    name: "Joseph",
    accent: "green",
    tags: ["Desarrollador"],
    eyebrow: "Coleccionista de Funkos",
    bio: "Soy el desarrollador de Spent, la página y las calculadoras de RIP Wallet. Me gusta jugar pádel y gastar en... pádel.",
    delay: "delay-6",
  },
  {
    img: brandonImg,
    alt: "Perfil de Brandon",
    name: "Brandon",
    accent: "purple",
    tags: ["Editor de video"],
    eyebrow: "Nunca duerme",
    bio: "Soy el que edita los videos de RIP y atiende los 1000 cambios que pide Kevin. Me gusta pasar con mi familia y gastar en mi perrito.",
    delay: "delay-7",
    imgPosition: "center 15%",
  },
];

const accentClasses: Record<string, { border: string; tag: string }> = {
  yellow: {
    border: "border-yellow-400/40",
    tag: "bg-yellow-50 text-yellow-700",
  },
  pink: {
    border: "border-pink-400/40",
    tag: "bg-pink-50 text-pink-700",
  },
  red: {
    border: "border-red-400/40",
    tag: "bg-red-50 text-red-700",
  },
  blue: {
    border: "border-blue-400/40",
    tag: "bg-blue-50 text-blue-700",
  },
  green: {
    border: "border-green-400/40",
    tag: "bg-green-50 text-green-700",
  },
  purple: {
    border: "border-purple-400/40",
    tag: "bg-purple-50 text-purple-700",
  },
  orange: {
    border: "border-orange-400/40",
    tag: "bg-orange-50 text-orange-700",
  },
};
---

<Layout
  title="El Equipo | RIP Wallet"
  description="Conoce a las personas que te ayudarán a tomar el control de tu dinero y alcanzar tu libertad financiera."
>
  <Navbar currentPath="/equipo" />

  <!-- Encabezado Principal -->
  <header class="max-w-7xl mx-auto px-6 pt-24 pb-16 text-center animate-reveal">
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-4">
      El equipo
    </h1>
    <p
      class="text-lg text-gray-500 max-w-2xl mx-auto font-medium leading-relaxed"
    >
      Queremos inspirar personas a tener mejores finanzas, para que puedan
      cambiar sus vidas y las vidas de otras personas.
    </p>
  </header>

  <!-- Cuadrícula de Equipo -->
  <main class="max-w-6xl mx-auto px-6 pb-32">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        team.map((member) => (
          <div
            class={`card-team ${accentClasses[member.accent].border} animate-reveal ${member.delay}`}
          >
            <div class="profile-img-container">
              <Image
                src={member.img}
                alt={member.alt}
                style={`border-radius: 8px; object-position: ${member.imgPosition ?? "center"};`}
              />
            </div>
            <h3 class="text-xl font-bold text-gray-900">{member.name}</h3>
            <p class="text-sm text-gray-400 mt-1 mb-3">
              {member.eyebrow}
            </p>
            {
              /* Carrusel horizontal de tags (pendiente de activar):
              <div class="tag-carousel flex flex-nowrap gap-2 mb-4 overflow-x-auto w-full">
                {member.tags.map((tag) => (
                  <span class={`shrink-0 text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full ${accentClasses[member.accent].tag}`}>
                    {tag}
                  </span>
                ))}
              </div>
              */
            }
            <div class="flex flex-wrap gap-2 mb-4">
              {member.tags.map((tag) => (
                <span
                  class={`text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full ${accentClasses[member.accent].tag}`}
                >
                  {tag}
                </span>
              ))}
            </div>
            <p class="text-xs text-gray-500 leading-relaxed">{member.bio}</p>
          </div>
        ))
      }
    </div>

    <!-- CTA -->
    <section class="mt-20 p-12 bg-gray-950 text-white rounded-3xl text-center">
      <h2 class="text-3xl font-bold mb-4">
        ¿Listo para transformar tu futuro?
      </h2>
      <p class="text-gray-400 mb-8 max-w-lg mx-auto text-sm">
        Únete a cientos de personas que ya están tomando el control total de sus
        finanzas con nuestras herramientas.
      </p>
      <div class="flex justify-center">
        <a
          href="/asesorias"
          class="bg-white text-black px-8 py-3 rounded-full font-bold text-xs uppercase tracking-widest hover:bg-gray-200 transition-colors inline-block"
        >
          Empezar ahora
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Estilo base de tarjeta */
  .card-team {
    background-color: #ffffff;
    border-radius: 24px;
    padding: 32px;
    border-width: 1.5px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
  }

  .card-team:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
  }

  /* Contenedor de imagen de perfil */
  .profile-img-container {
    width: 96px;
    height: 96px;
    margin-bottom: 24px;
    overflow: hidden;
    background-color: #f9fafb;
    flex-shrink: 0;
    border-radius: 12px;
  }

  .profile-img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Carrusel de tags (pendiente de activar): scroll horizontal sin barra visible
  .tag-carousel {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .tag-carousel::-webkit-scrollbar {
    display: none;
  }
  */

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-reveal {
    opacity: 0;
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-1 {
    animation-delay: 0.1s;
  }
  .delay-2 {
    animation-delay: 0.2s;
  }
  .delay-3 {
    animation-delay: 0.3s;
  }
  .delay-4 {
    animation-delay: 0.4s;
  }
  .delay-5 {
    animation-delay: 0.5s;
  }
  .delay-6 {
    animation-delay: 0.6s;
  }
  .delay-7 {
    animation-delay: 0.7s;
  }
</style>
