---
import Site from "../layouts/Site.astro";
import html from "../content/rediseno/index.html?raw";
---

<Site title="RIP Wallet | Finanzas prácticas y transparentes" description="Asesorías 1:1 para salir de deudas, entender tus tarjetas y empezar a invertir en entidades reguladas de Costa Rica." currentPath="/">
  <Fragment set:html={html} />
</Site>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (v: string) => parseFloat(String(v).replace(/[^0-9.]/g, "")) || 0;
  function calc() {
    const P = num($("monto").value), r = num($("tasa").value) / 100 / 12, n = num($("plazo").value) * 12;
    let c = 0;
    if (P > 0 && n > 0) c = r > 0 ? (P * r) / (1 - Math.pow(1 + r, -n)) : P / n;
    $("cuota").textContent = "¢" + Math.round(c).toLocaleString("en-US");
  }
  ["monto", "tasa", "plazo"].forEach((id) => $(id).addEventListener("input", calc));
  calc();
</script>
