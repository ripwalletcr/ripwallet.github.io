---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { ArrowLeft, Download } from "@lucide/astro";
import { spentTutoriales, type Tutorial } from "../../../data/spent-tutoriales";

export function getStaticPaths() {
  return spentTutoriales.map((tutorial) => ({
    params: { slug: tutorial.slug },
    props: { tutorial },
  }));
}

interface Props {
  tutorial: Tutorial;
}

const { tutorial } = Astro.props;
const versions = tutorial.versions.filter((v) => v.steps.length > 0);
const defaultVersion = versions[0]?.id;
---

<Layout title={`${tutorial.title} | Spent`} description={tutorial.summary}>
  <Navbar currentPath="/apps" />

  <main class="max-w-3xl mx-auto px-6 pt-16 pb-32">
    <a
      href="/spent/tutoriales"
      class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 hover:text-green-700 mb-10"
    >
      <ArrowLeft class="w-3 h-3" /> Tutoriales de Spent
    </a>

    <header class="mb-10 animate-reveal">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">{tutorial.title}</h1>
      <p class="text-lg text-gray-500 font-medium leading-relaxed">{tutorial.summary}</p>
    </header>

    {
      versions.length > 1 && (
        <div class="version-tabs animate-reveal delay-1" role="tablist" aria-label="Versión de iOS">
          {versions.map((v) => (
            <button
              type="button"
              role="tab"
              class="version-tab"
              data-version={v.id}
              aria-selected={v.id === defaultVersion ? "true" : "false"}
            >
              {v.label}
            </button>
          ))}
        </div>
      )
    }
    {
      versions.length > 1 && (
        <p class="text-xs text-gray-400 mt-3 mb-10 animate-reveal delay-1">
          ¿No sabes qué versión tienes? Ve a <strong class="text-gray-500">Ajustes › General › Información</strong>.
        </p>
      )
    }

    {
      versions.map((v) => (
        <section class="version-panel animate-reveal delay-2" data-version={v.id} role="tabpanel" hidden={v.id !== defaultVersion}>
          {v.note && <p class="note" set:html={v.note} />}
          {v.shortcut && (
            <a
              href={v.shortcut.url}
              target="_blank"
              rel="noopener"
              class="group flex items-center gap-4 p-4 mb-10 rounded-2xl border border-green-100 bg-[#f2faf3] hover:border-green-300 hover:bg-green-50 transition-colors"
            >
              <div class="w-10 h-10 rounded-xl bg-white border border-green-100 flex items-center justify-center text-green-600 shrink-0">
                <Download class="w-5 h-5" />
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-bold text-green-950">¿Prefieres el atajo listo?</p>
                <p class="text-xs text-green-800/70">{v.shortcut.text}</p>
              </div>
            </a>
          )}
          <ol class="steps">
            {v.steps.map((step, i) => (
              <li class="step">
                <div class="step-num">{i + 1}</div>
                <div class="step-body">
                  <h2 class="step-title">{step.title}</h2>
                  {step.body && <p class="step-text" set:html={step.body} />}
                  {step.media && (
                    <div class="step-media">
                      {step.media.map((m) => (
                        <figure>
                          {m.type === "video" ? (
                            <video src={m.src} aria-label={m.alt} autoplay muted loop playsinline preload="metadata" />
                          ) : (
                            <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                          )}
                          {m.caption && <figcaption>{m.caption}</figcaption>}
                        </figure>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <section class="mt-16 p-10 rounded-[2rem] text-center cta-spent">
      <h2 class="text-2xl font-bold mb-2 text-[#0b2f18]">¿Todavía no tienes Spent?</h2>
      <p class="text-sm text-[#0b2f18]/70 mb-6">Descárgalo gratis para iPhone y Android.</p>
      <a
        href="/spent/download"
        class="inline-flex items-center gap-2 rounded-full bg-[#0b2f18] px-6 py-3 text-sm font-bold text-white transition-transform hover:scale-105"
      >
        Descargar Spent
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".version-tab");
  const panels = document.querySelectorAll<HTMLElement>(".version-panel");

  function select(id: string) {
    tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.version === id)));
    panels.forEach((p) => (p.hidden = p.dataset.version !== id));
  }

  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      const id = t.dataset.version!;
      select(id);
      history.replaceState(null, "", `#${id}`);
    }),
  );

  const fromHash = location.hash.slice(1);
  if (fromHash && [...tabs].some((t) => t.dataset.version === fromHash)) select(fromHash);
</script>

<style is:global>
  .version-tabs {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: #f3f4f6;
  }
  .version-tab {
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.2s;
  }
  .version-tab[aria-selected="true"] {
    background: #0b2f18;
    color: #fff;
  }
  .note {
    font-size: 0.875rem;
    color: #374151;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .step {
    display: flex;
    gap: 1.25rem;
    position: relative;
    padding-bottom: 2.5rem;
  }
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 1.0625rem;
    top: 2.75rem;
    bottom: 0.5rem;
    width: 2px;
    background: #e5efe7;
  }
  .step-num {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: #eefcf1;
    border: 1.5px solid #86efac;
    color: #166534;
    font-weight: 800;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step-body {
    min-width: 0;
    flex: 1;
    padding-top: 0.25rem;
  }
  .step-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.4;
  }
  .step-text {
    margin-top: 0.375rem;
    color: #4b5563;
    line-height: 1.65;
  }
  .step-text a {
    color: #15803d;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .step-media {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  .step-media figure {
    margin: 0;
    max-width: 100%;
  }
  .step-media img,
  .step-media video {
    display: block;
    max-width: min(100%, 340px);
    max-height: 560px;
    width: auto;
    height: auto;
    border-radius: 1.25rem;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.35);
    background: #f2f2f7;
  }
  .step-media figcaption {
    margin-top: 0.5rem;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #9ca3af;
  }
  .cta-spent {
    background: radial-gradient(120% 160% at 85% 0%, #a8f0bb 0%, #7ce495 45%, #5cd17d 100%);
  }
  @keyframes reveal {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-reveal {
    opacity: 0;
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.2s; }
</style>
