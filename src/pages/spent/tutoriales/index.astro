---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { ArrowRight } from "@lucide/astro";
import { spentTutoriales } from "../../../data/spent-tutoriales";
---

<Layout
  title="Tutoriales de Spent | RIP Wallet"
  description="Guías paso a paso para sacarle el máximo a Spent: automatizaciones, atajos y más."
>
  <Navbar currentPath="/apps" />

  <header class="max-w-3xl mx-auto px-6 pt-24 pb-14 text-center animate-reveal">
    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-green-700 mb-4">
      <a href="/apps" class="hover:text-green-900">Spent</a> · Tutoriales
    </p>
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-4">Tutoriales</h1>
    <p class="text-lg text-gray-500 max-w-xl mx-auto font-medium leading-relaxed">
      Guías paso a paso para sacarle el máximo a Spent.
    </p>
  </header>

  <main class="max-w-3xl mx-auto px-6 pb-32 space-y-4">
    {
      spentTutoriales.map((t, i) => {
        return (
          <a
            href={`/spent/tutoriales/${t.slug}`}
            class={`tutorial-card group animate-reveal delay-${Math.min(i + 1, 3)}`}
          >
            <img src={t.icon} alt="" width="48" height="48" class="w-12 h-12 shrink-0" />
            <div class="min-w-0 flex-1">
              <h2 class="text-lg font-bold text-gray-900 leading-snug">{t.title}</h2>
              <p class="text-sm text-gray-500 mt-1 leading-relaxed">{t.summary}</p>
              <div class="flex flex-wrap gap-2 mt-3">
                <span class="chip">{t.platform}</span>
                {t.versions.length > 1 && t.versions.filter((v) => v.steps.length > 0).map((v) => (
                  <span class="chip">{v.label}</span>
                ))}
              </div>
            </div>
            <ArrowRight class="w-5 h-5 text-gray-300 shrink-0 self-center transition-transform group-hover:translate-x-1 group-hover:text-green-700" />
          </a>
        );
      })
    }
  </main>

  <Footer />
</Layout>

<style is:global>
  .tutorial-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    border: 1.5px solid #e5efe7;
    background: #fff;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tutorial-card:hover {
    border-color: #86efac;
    box-shadow: 0 12px 32px -16px rgba(11, 47, 24, 0.25);
    transform: translateY(-2px);
  }
  .chip {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #166534;
    background: #eefcf1;
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }
  @keyframes reveal {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-reveal {
    opacity: 0;
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.2s; }
  .delay-3 { animation-delay: 0.3s; }
</style>
