              x: {
                ticks: { font: { size: 8 }, color: "#9ca3af", maxRotation: 0, autoSkip: true, maxTicksLimit: 10 },
                grid: { display: false },
              },
            },
          },
        });
      }

      const bestTimeCanvas = document.getElementById("bestTimeChartVideos") as HTMLCanvasElement | null;
      if (bestTimeCanvas) {
        bestTimeChartVideos = new Chart(bestTimeCanvas.getContext("2d")!, {
          type: "bar",
          data: {
            labels: (vid.hours || []).map((h: number) => `${h}h`),
            datasets: [
              {
                label: "TikTok",
                data: vid.bestTimeToPost?.tiktok || [],
                backgroundColor: "rgba(23, 163, 74, 0.7)",
              },
              {
                label: "Instagram",
                data: vid.bestTimeToPost?.instagram || [],
                backgroundColor: "rgba(219, 39, 119, 0.6)",
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: "top", labels: { boxWidth: 10, font: { size: 11 } } } },
            scales: {
              y: { min: 0, max: 1, ticks: { font: { size: 9 }, color: "#9ca3af" }, grid: { color: "#f1f5f9" } },
              x: { ticks: { font: { size: 8 }, color: "#9ca3af" }, grid: { display: false } },
            },
          },
        });
      }
    }
  }

  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".tab-btn"));
  const panels: Record<string, HTMLElement | null> = {
    asesorias: document.getElementById("tab-asesorias"),
    inversiones: document.getElementById("tab-inversiones"),
    videos: document.getElementById("tab-videos"),
  };
  const filterBar = document.getElementById("filterBar");
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn"));
  let currentFilter = "ytd";
  let activeTab = "asesorias";

  function showTab(tab: string) {
    activeTab = tab;
    for (const [key, el] of Object.entries(panels)) {
      if (el) el.hidden = key !== tab;
    }
    tabButtons.forEach((btn) => btn.classList.toggle("active", btn.dataset.tab === tab));
    if (filterBar) filterBar.hidden = tab === "videos";
    initChartsForTab(tab);
    if (tab === "asesorias") updateAsesoriasView(currentFilter);
    if (tab === "inversiones") updateInversionesView(currentFilter);
  }

  tabButtons.forEach((btn) => btn.addEventListener("click", () => showTab(btn.dataset.tab || "asesorias")));

  filterButtons.forEach((btn) =>
    btn.addEventListener("click", () => {
      currentFilter = btn.dataset.filter || "ytd";
      filterButtons.forEach((b) => b.classList.toggle("active", b === btn));
      if (activeTab === "asesorias") updateAsesoriasView(currentFilter);
      if (activeTab === "inversiones") updateInversionesView(currentFilter);
    }),
  );

  showTab("asesorias");
</script>

