              y: { position: "left", ticks: { font: { size: 9 }, color: "#9ca3af" }, grid: { color: "#f1f5f9" } },
              y1: { position: "right", ticks: { font: { size: 9 }, color: "#9ca3af" }, grid: { display: false } },
              x: { ticks: { font: { size: 8 }, color: "#9ca3af", maxRotation: 0 }, grid: { display: false } },
            },
          },
        });
      }

      const bestTimeCanvas = document.getElementById("bestTimeChartAsesorias") as HTMLCanvasElement | null;
      if (bestTimeCanvas) {
        bestTimeChartAsesorias = new Chart(bestTimeCanvas.getContext("2d")!, {
          type: "bar",
          data: {
            labels: (biz.months ? Array.from({ length: 24 }, (_, h) => h) : []).map((h: number) => `${h}h`),
            datasets: [
              {
                label: "Reservas",
                data: biz.bestTimeToBook || [],
                backgroundColor: "rgba(23, 163, 74, 0.7)",
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { min: 0, max: 1, ticks: { font: { size: 9 }, color: "#9ca3af" }, grid: { color: "#f1f5f9" } },
              x: { ticks: { font: { size: 8 }, color: "#9ca3af" }, grid: { display: false } },
            },
          },
        });
      }
    }

    if (tab === "inversiones" && !funnelChart) {
      const canvas = document.getElementById("funnelChart") as HTMLCanvasElement | null;
      if (canvas) {
        funnelChart = new Chart(canvas.getContext("2d")!, {
          type: "line",
          data: {
            labels: [],
            datasets: [
              {
                label: "Clientes atendidos",
                data: [],
                borderColor: "#2563eb",
                backgroundColor: "rgba(37, 99, 235, 0.06)",
                borderWidth: 2,
                pointRadius: 2,
                fill: true,
                tension: 0.3,
              },
              {
                label: "Cerrados (Ganado)",
                data: [],
                borderColor: "#17A34A",
                backgroundColor: "rgba(23, 163, 74, 0.08)",
                borderWidth: 2,
                pointRadius: 2,
                fill: true,
                tension: 0.3,
              },
