          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: "top", labels: { boxWidth: 10, font: { size: 11 } } } },
            scales: {
              y: { ticks: { font: { size: 9 }, color: "#9ca3af" }, grid: { color: "#f1f5f9" } },
              x: { ticks: { font: { size: 8 }, color: "#9ca3af", maxRotation: 0 }, grid: { display: false } },
            },
          },
        });
      }
    }

    if (tab === "videos" && !weeklyTrendChartVideos) {
      const weeklyCanvas = document.getElementById("weeklyTrendChartVideos") as HTMLCanvasElement | null;
      if (weeklyCanvas) {
        weeklyTrendChartVideos = new Chart(weeklyCanvas.getContext("2d")!, {
          type: "line",
          data: {
            labels: vid.weeklyTrend?.weeks || [],
            datasets: [
              {
                label: "TikTok",
                data: vid.weeklyTrend?.series?.tiktok || [],
                borderColor: "#17A34A",
                backgroundColor: "rgba(23, 163, 74, 0.06)",
                borderWidth: 2,
                pointRadius: 0,
                fill: true,
                tension: 0.3,
              },
              {
                label: "Instagram",
                data: vid.weeklyTrend?.series?.instagram || [],
