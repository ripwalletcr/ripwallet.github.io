              {
                type: "bar",
                label: "Asesorías",
                data: [],
                backgroundColor: "rgba(23, 163, 74, 0.7)",
                yAxisID: "y",
              },
              {
                type: "line",
                label: "Ingreso (₡)",
                data: [],
                borderColor: "#2563eb",
                backgroundColor: "rgba(37, 99, 235, 0.08)",
                borderWidth: 2,
                pointRadius: 0,
                fill: true,
                tension: 0.3,
                yAxisID: "y1",
              },
