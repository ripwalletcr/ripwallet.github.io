---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import BannerTabs from "../../components/BannerTabs.astro";
import { tabsStoreLinks } from "../../constants/apps-config";

const screenshots = [
  { src: "/images/tabs/screenshot-1.jpg", alt: "Pantalla principal de Tabs mostrando las deudas del usuario" },
  { src: "/images/tabs/screenshot-2.jpg", alt: "Calculadora de Tabs para simular abonos extra a una deuda" },
  { src: "/images/tabs/screenshot-3.jpg", alt: "Tabs muestra exactamente cuándo termina de pagar cada deuda" },
];
---

<Layout
  title="Tabs | RIP Wallet"
  description="Tabs es el app para llevar el control de tus deudas y tu patrimonio, y saber exactamente cuándo terminás de pagar cada una. Descárgala gratis para iOS y Android."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&display=swap"
    rel="stylesheet"
    slot="head"
  />

  <Navbar currentPath="/tabs" />

  <!-- Hero -->
  <header class="max-w-4xl mx-auto px-6 pt-24 pb-4 text-center animate-reveal">
    <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400 mb-4">
      App
    </p>
    <h1
      class="text-5xl md:text-6xl font-bold tracking-tight mb-6"
      style="font-family: 'Bricolage Grotesque', sans-serif;"
    >
      Tabs
    </h1>
    <p class="text-lg text-gray-500 max-w-xl mx-auto font-medium">
      Tu ruta para salir de deudas
    </p>
  </header>

  <main class="max-w-4xl mx-auto px-6 pb-32">
    <div class="max-w-2xl mx-auto text-center space-y-4 text-gray-500 leading-relaxed mb-10 animate-reveal delay-1">
      <p>
        Tabs te muestra, deuda por deuda, exactamente cuándo terminás de
        pagarla y cuánto te está costando en intereses.
      </p>
      <p>
        Jugá con distintos escenarios de abonos extra y mirá cuántos meses y
        cuánto dinero te podés ahorrar si le metés un poco más cada mes.
      </p>
      <p>
        También te ayuda a llevar el control de tu patrimonio, todo en un solo
        lugar. Es gratis y funciona tanto en iPhone como en Android.
      </p>
    </div>

    <div class="flex justify-center mb-16 animate-reveal delay-2">
      <a
        href="/tabs/download"
        class="bg-gray-950 text-white px-10 py-5 rounded-full font-bold text-sm uppercase tracking-widest hover:bg-gray-800 transition-colors inline-block"
      >
        Descargar Tabs
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-16 animate-reveal delay-3">
      {screenshots.map((screenshot) => (
        <img
          src={screenshot.src}
          alt={screenshot.alt}
          class="w-full h-auto rounded-3xl first:col-span-2 sm:first:col-span-1"
        />
      ))}
    </div>

    <div class="animate-reveal delay-4">
      <BannerTabs iphoneUrl={tabsStoreLinks.ios} androidUrl={tabsStoreLinks.android} />
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-reveal {
    opacity: 0;
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-1 {
    animation-delay: 0.1s;
  }
  .delay-2 {
    animation-delay: 0.2s;
  }
  .delay-3 {
    animation-delay: 0.3s;
  }
  .delay-4 {
    animation-delay: 0.4s;
  }
</style>
