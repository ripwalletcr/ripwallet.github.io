---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
  Eye,
  Heart,
  Share2,
  Flame,
  Bookmark,
  Clock,
  RefreshCw,
  Lightbulb,
  TrendingUp,
} from "@lucide/astro";
import dashboard from "../data/video-insights.json";

const {
  generatedAt,
  source,
  kpis,
  weeklyTrend,
  tiktokTopics,
  topVideos,
  remakeCandidates,
  networkComparison30d,
  bestTimeToPost,
  contentIdeas,
} = dashboard;

const numberFmt = new Intl.NumberFormat("es-CR");
const dateFmt = new Intl.DateTimeFormat("es-CR", {
  dateStyle: "medium",
  timeZone: "America/Costa_Rica",
});
const dateTimeFmt = new Intl.DateTimeFormat("es-CR", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "America/Costa_Rica",
});

function truncate(text: string, max = 70) {
  if (!text) return "";
  return text.length > max ? text.slice(0, max).trim() + "…" : text;
}

const hours = Array.from({ length: 24 }, (_, i) => i);
const networkLabels = { tiktok: "TikTok", instagram: "Instagram" };
---

<Layout
  title="Rendimiento de Videos | RIP Wallet"
  description="Dashboard interno de insights de video de RIP Wallet en Instagram Reels y TikTok."
>
  <Navbar currentPath="/rendimiento-videos" />

  <main class="max-w-7xl mx-auto px-6 pt-16 pb-32">
    <header class="mb-12 animate-reveal">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-3">
        Rendimiento de Videos
      </h1>
      <p class="text-sm text-gray-500 flex flex-wrap items-center gap-2">
        <span class="flex items-center gap-1.5">
          <Clock class="w-3.5 h-3.5" /> Última actualización: {dateTimeFmt.format(
            new Date(generatedAt),
          )}
        </span>
        {
          source === "sample" && (
            <span class="status-dot-badge">
              Datos de muestra — conecta Metricool para ver datos reales
            </span>
          )
        }
      </p>
    </header>

    <!-- KPIs -->
    <section class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-12 animate-reveal">
      <div class="card-outline">
        <Eye class="w-4 h-4 text-gray-400 mb-3" />
        <p class="text-2xl font-bold">{numberFmt.format(kpis.totalViews)}</p>
        <p class="kpi-label">Vistas totales</p>
      </div>
      <div class="card-outline">
        <TrendingUp class="w-4 h-4 text-gray-400 mb-3" />
        <p class="text-2xl font-bold">{numberFmt.format(kpis.avgViewsPerVideo)}</p>
        <p class="kpi-label">Vistas promedio / video</p>
      </div>
      <div class="card-outline">
        <Heart class="w-4 h-4 text-gray-400 mb-3" />
        <p class="text-2xl font-bold">{kpis.avgEngagementRate}%</p>
        <p class="kpi-label">Engagement promedio</p>
      </div>
      <div class="card-outline">
        <Share2 class="w-4 h-4 text-gray-400 mb-3" />
        <p class="text-2xl font-bold">{numberFmt.format(kpis.sharesTotal.tiktok)}</p>
        <p class="kpi-label">Shares TikTok</p>
      </div>
      <div class="card-outline">
        <Share2 class="w-4 h-4 text-gray-400 mb-3" />
        <p class="text-2xl font-bold">{numberFmt.format(kpis.sharesTotal.instagram)}</p>
        <p class="kpi-label">Shares Instagram</p>
      </div>
    </section>

    <!-- Weekly trend -->
    <section class="card-outline mb-12 animate-reveal">
      <h2 class="section-title">Tendencia semanal de vistas</h2>
      <div class="h-72">
        <canvas id="weeklyTrendChart"></canvas>
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- TikTok topics -->
      <section class="card-outline animate-reveal">
        <h2 class="section-title">Rendimiento por tema (TikTok)</h2>
        <div class="overflow-x-auto">
          <table class="data-table">
            <thead>
              <tr>
                <th>Tema</th>
                <th class="text-right">Videos</th>
                <th class="text-right">Vistas prom.</th>
                <th class="text-right">Engagement</th>
                <th class="text-right">Shares prom.</th>
              </tr>
            </thead>
            <tbody>
              {
                tiktokTopics.map((topic) => (
                  <tr>
                    <td>{topic.label}</td>
                    <td class="text-right">{topic.videoCount}</td>
                    <td class="text-right">{numberFmt.format(topic.avgViews)}</td>
                    <td class="text-right">{topic.avgEngagementRate}%</td>
                    <td class="text-right">{topic.avgShares}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- Best time to post -->
      <section class="card-outline animate-reveal">
        <h2 class="section-title">Mejor momento para publicar</h2>
        <p class="text-xs text-gray-400 mb-4">
          Ritmo horario normalizado sobre el pico del día · hora Costa Rica
        </p>
        <div class="h-56">
          <canvas id="bestTimeChart"></canvas>
        </div>
      </section>
    </div>

    <!-- Top videos -->
    <section class="mb-12 animate-reveal">
      <h2 class="section-title mb-6">Top videos</h2>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="card-outline">
          <h3 class="subsection-title">
            <Flame class="w-3.5 h-3.5 mr-1.5 inline" /> TikTok por vistas
          </h3>
          <ul class="video-list">
            {
              topVideos.tiktokByViews.slice(0, 5).map((v) => (
                <li>
                  <a href={v.url} target="_blank" rel="noopener noreferrer">
                    {truncate(v.caption, 55)}
                  </a>
                  <span class="video-metric">{numberFmt.format(v.views)} vistas</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card-outline">
          <h3 class="subsection-title">
            <Flame class="w-3.5 h-3.5 mr-1.5 inline" /> Instagram por vistas
          </h3>
          <ul class="video-list">
            {
              topVideos.instagramByViews.slice(0, 5).map((v) => (
                <li>
                  <a href={v.url} target="_blank" rel="noopener noreferrer">
                    {truncate(v.caption, 55)}
                  </a>
                  <span class="video-metric">{numberFmt.format(v.views)} vistas</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card-outline">
          <h3 class="subsection-title">
            <Bookmark class="w-3.5 h-3.5 mr-1.5 inline" /> Reels por guardados
          </h3>
          <ul class="video-list">
            {
              topVideos.instagramBySaves.slice(0, 5).map((v) => (
                <li>
                  <a href={v.url} target="_blank" rel="noopener noreferrer">
                    {truncate(v.caption, 55)}
                  </a>
                  <span class="video-metric">{numberFmt.format(v.saved)} guardados</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- Remake candidates -->
      <section class="card-outline animate-reveal">
        <h2 class="section-title">
          <RefreshCw class="w-4 h-4 mr-1.5 inline" /> Candidatos para rehacer
        </h2>
        <ul class="video-list">
          {
            remakeCandidates.map((v) => (
              <li>
                <a href={v.url} target="_blank" rel="noopener noreferrer">
                  {networkLabels[v.network]} · {truncate(v.caption, 45)}
                </a>
                <span class="video-metric">
                  {numberFmt.format(v.views)} vistas · {dateFmt.format(new Date(v.publishedAt))}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Instagram vs TikTok comparison -->
      <section class="card-outline animate-reveal">
        <h2 class="section-title">Instagram vs TikTok (últimos 30 días)</h2>
        <table class="data-table">
          <thead>
            <tr>
              <th>Métrica</th>
              <th class="text-right">Instagram</th>
              <th class="text-right">TikTok</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Vistas totales</td>
              <td class="text-right">{numberFmt.format(networkComparison30d.instagram.totalViews)}</td>
              <td class="text-right">{numberFmt.format(networkComparison30d.tiktok.totalViews)}</td>
            </tr>
            <tr>
              <td>Vistas prom. / video</td>
              <td class="text-right">{numberFmt.format(networkComparison30d.instagram.avgViewsPerVideo)}</td>
              <td class="text-right">{numberFmt.format(networkComparison30d.tiktok.avgViewsPerVideo)}</td>
            </tr>
            <tr>
              <td>Shares promedio</td>
              <td class="text-right">{networkComparison30d.instagram.avgShares}</td>
              <td class="text-right">{networkComparison30d.tiktok.avgShares}</td>
            </tr>
            <tr>
              <td>Engagement rate</td>
              <td class="text-right">{networkComparison30d.instagram.avgEngagementRate}%</td>
              <td class="text-right">{networkComparison30d.tiktok.avgEngagementRate}%</td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>

    <!-- Content ideas -->
    <section class="card-outline animate-reveal">
      <h2 class="section-title">
        <Lightbulb class="w-4 h-4 mr-1.5 inline" /> Ideas de contenido nuevo
      </h2>
      <ul class="idea-list">
        {contentIdeas.map((idea) => <li>{idea}</li>)}
      </ul>
    </section>
  </main>

  <Footer />
</Layout>

<script type="application/json" id="chart-data" set:html={JSON.stringify({ weeklyTrend, bestTimeToPost, hours })} />

<script>
  import Chart from "chart.js/auto";

  const chartDataEl = document.getElementById("chart-data");
  const { weeklyTrend, bestTimeToPost, hours } = JSON.parse(chartDataEl?.textContent || "{}");

  {
    const weeklyCanvas = document.getElementById("weeklyTrendChart");
    if (weeklyCanvas) {
      new Chart(weeklyCanvas.getContext("2d"), {
        type: "line",
        data: {
          labels: weeklyTrend.weeks,
          datasets: [
            {
              label: "TikTok",
              data: weeklyTrend.series.tiktok,
              borderColor: "#17A34A",
              backgroundColor: "rgba(23, 163, 74, 0.06)",
              borderWidth: 2,
              pointRadius: 0,
              fill: true,
              tension: 0.3,
            },
            {
              label: "Instagram",
              data: weeklyTrend.series.instagram,
              borderColor: "#db2777",
              backgroundColor: "rgba(219, 39, 119, 0.05)",
              borderWidth: 2,
              pointRadius: 0,
              fill: true,
              tension: 0.3,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "top", labels: { boxWidth: 10, font: { size: 11 } } } },
          scales: {
            y: {
              ticks: { font: { size: 9 }, color: "#9ca3af" },
              grid: { color: "#f1f5f9" },
            },
            x: {
              ticks: { font: { size: 8 }, color: "#9ca3af", maxRotation: 0, autoSkip: true, maxTicksLimit: 10 },
              grid: { display: false },
            },
          },
        },
      });
    }

    const bestTimeCanvas = document.getElementById("bestTimeChart");
    if (bestTimeCanvas) {
      new Chart(bestTimeCanvas.getContext("2d"), {
        type: "bar",
        data: {
          labels: hours.map((h) => `${h}h`),
          datasets: [
            {
              label: "TikTok",
              data: bestTimeToPost.tiktok,
              backgroundColor: "rgba(23, 163, 74, 0.7)",
            },
            {
              label: "Instagram",
              data: bestTimeToPost.instagram,
              backgroundColor: "rgba(219, 39, 119, 0.6)",
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "top", labels: { boxWidth: 10, font: { size: 11 } } } },
          scales: {
            y: { min: 0, max: 1, ticks: { font: { size: 9 }, color: "#9ca3af" }, grid: { color: "#f1f5f9" } },
            x: { ticks: { font: { size: 8 }, color: "#9ca3af" }, grid: { display: false } },
          },
        },
      });
    }
  }
</script>

<style is:global>
  .card-outline {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    padding: 32px;
    transition: border-color 0.3s ease;
  }

  .card-outline:hover {
    border-color: #cbd5e1;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #6b7280;
    margin-bottom: 1.5rem;
  }

  .subsection-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #9ca3af;
    margin-bottom: 1rem;
  }

  .kpi-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9ca3af;
    margin-top: 0.25rem;
  }

  .status-dot-badge {
    background-color: #fef3c7;
    color: #92400e;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .data-table {
    width: 100%;
    font-size: 0.8rem;
    border-collapse: collapse;
  }

  .data-table th {
    text-align: left;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9ca3af;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .data-table td {
    padding: 0.6rem 0;
    border-bottom: 1px solid #f8fafc;
  }

  .video-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .video-list li {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #f8fafc;
  }

  .video-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .video-list a {
    font-size: 0.8rem;
    font-weight: 500;
    color: #111827;
    text-decoration: none;
  }

  .video-list a:hover {
    text-decoration: underline;
  }

  .video-metric {
    font-size: 0.7rem;
    color: #9ca3af;
    margin-top: 0.15rem;
  }

  .idea-list {
    list-style: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: #374151;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-reveal {
    opacity: 0;
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
