---
import { Image } from "astro:assets";
import tabsPreview from "../images/preview_tabs.png";

interface Props {
  iphoneUrl?: string;
  androidUrl?: string;
}

const { iphoneUrl = "#", androidUrl = "#" } = Astro.props;
---

<section
  class="banner-tabs relative overflow-hidden rounded-[2.5rem] bg-neutral-950 text-white"
>
  <div class="relative z-10 p-8 sm:p-12 lg:max-w-[58%]">
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
      Descarga el app<span class="text-yellow-400">!</span>
    </h2>

    <p class="mt-6 max-w-xl leading-relaxed text-neutral-200">
      Con <strong class="font-bold text-white">Tabs.</strong> puedes llevar el registro
      de cada pago, hacer cálculos de abonos extras y ver cómo se acerca la fecha
      de cancelación de tu deuda, en tiempo real.
    </p>

    <p class="mt-6 text-neutral-200">
      Toca abajo para <strong class="font-bold text-white">descargar gratis</strong>
    </p>

    <div class="mt-6 flex flex-nowrap gap-4">
      <a
        href={iphoneUrl}
        class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-neutral-900 transition-transform hover:scale-105"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"></path>
        </svg>
        Para iPhone
      </a>
      <a
        href={androidUrl}
        class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-neutral-900 transition-transform hover:scale-105"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.523 15.34a.996.996 0 1 1 0-1.992.996.996 0 0 1 0 1.992m-11.046 0a.996.996 0 1 1 0-1.992.996.996 0 0 1 0 1.992m11.4-6.02 1.99-3.446a.415.415 0 0 0-.152-.566.416.416 0 0 0-.566.152l-2.015 3.49A12.1 12.1 0 0 0 12 7.921c-1.848 0-3.594.363-5.134 1.03L4.851 5.46a.416.416 0 0 0-.566-.152.415.415 0 0 0-.152.566l1.99 3.446C2.694 11.186.344 14.658 0 18.761h24c-.344-4.103-2.694-7.575-6.123-9.44"></path>
        </svg>
        Para Android
      </a>
    </div>
  </div>

  <div class="phone-wrapper hidden lg:block">
    <Image
      src={tabsPreview}
      alt="App Tabs en un iPhone"
      width={900}
      quality={95}
      class="phone-img"
    />
  </div>
</section>

<style>
  .banner-tabs {
    background: radial-gradient(
      120% 160% at 85% 0%,
      #2e2e2e 0%,
      #181818 45%,
      #0a0a0a 100%
    );
  }

  .phone-wrapper {
    position: absolute;
    right: -1.5rem;
    bottom: -80px;
    width: 420px;
    z-index: 20;
  }

  .phone-img {
    width: 100%;
    height: auto;
    transform: perspective(1400px) rotateY(-6deg) rotateZ(-4deg);
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.65));
  }
</style>
