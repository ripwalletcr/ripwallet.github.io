---
import { Image } from "astro:assets";
import spentBanner from "../images/spent_banner.png";

interface Props {
  downloadUrl?: string;
}

const { downloadUrl = "#" } = Astro.props;
---

<div class="relative">
  <section
    class="banner-spent relative overflow-hidden rounded-[2.5rem] text-[#0b2f18] lg:min-h-[420px]"
  >
    <div class="relative z-10 p-8 sm:p-12 lg:max-w-[58%]">
      <h2
        class="text-4xl sm:text-5xl font-extrabold tracking-tight"
        style="font-family: 'Outfit', sans-serif;"
      >
        Spent
      </h2>

      <p class="mt-6 max-w-xl leading-relaxed text-[#0b2f18]/80">
        Con <strong class="font-bold text-[#0b2f18]" style="font-family: 'Outfit', sans-serif;">Spent</strong> puedes
        llevar un control de tus gastos y de tus suscripciones en un solo lugar,
        para que no se te pierda nada y puedas seguir el presupuesto.
      </p>

      <p class="mt-6 text-[#0b2f18]/80">
        Disponible <strong class="font-bold text-[#0b2f18]">gratis</strong> para iPhone
        y Android
      </p>

      <div class="mt-6">
        <a
          href={downloadUrl}
          class="inline-flex items-center gap-2 rounded-full bg-[#0b2f18] px-6 py-3 text-sm font-bold text-white transition-transform hover:scale-105"
        >
          Descargar Spent
        </a>
      </div>
    </div>
  </section>

  <div class="phone-wrapper hidden lg:block">
    <Image
      src={spentBanner}
      alt="App Spent en un iPhone"
      width={320}
      quality={95}
      class="phone-img"
    />
  </div>
</div>

<style>
  .banner-spent {
    background: radial-gradient(
      120% 160% at 85% 0%,
      #a8f0bb 0%,
      #7ce495 45%,
      #5cd17d 100%
    );
  }

  .phone-wrapper {
    position: absolute;
    right: 0;
    bottom: -30px;
    width: 320px;
    z-index: 20;
  }

  .phone-img {
    width: 100%;
    height: auto;
    transform: perspective(1400px) rotateY(-6deg) rotateZ(-4deg);
    filter: drop-shadow(0 24px 48px rgba(11, 47, 24, 0.35));
  }
</style>
