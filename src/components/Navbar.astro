---
import { Image } from "astro:assets";
import logo from "../images/ripwallet_circle.png";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const herramientas = [
  "/herramientas",
  "/amortizacion",
  "/calculadora",
  "/cuotas",
  "/inversion",
  "/mediana",
  "/tarjetas",
  "/recursos",
];
const section = herramientas.some((p) => currentPath.startsWith(p))
  ? "herramientas"
  : currentPath.split("/")[1] || "inicio";
const current = (s: string) => (section === s ? "page" : undefined);
const sub = (p: string) => (currentPath === p ? "page" : undefined);
---

<nav class="top" aria-label="Principal">
  <div class="wrap">
    <a class="brand" href="/">
      <Image src={logo} alt="" width={30} height={30} densities={[1, 2, 3]} quality="max" />
      RIP Wallet
    </a>
    <div class="links" id="nav-links">
      <a href="/asesorias" aria-current={current("asesorias")}>Asesorías</a>
      <div class="dd">
        <a href="/herramientas" aria-current={current("herramientas")}>Herramientas</a>
        <div class="dd-menu">
          <a href="/amortizacion" aria-current={sub("/amortizacion")}><span class="ticon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg></span>Calculadora de amortización</a>
          <a href="/cuotas" aria-current={sub("/cuotas")}><span class="ticon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19 5 5 19"></path><circle cx="7" cy="7" r="2.5"></circle><circle cx="17" cy="17" r="2.5"></circle></svg></span>Comparadora de cuotas</a>
          <a href="/inversion" aria-current={sub("/inversion")}><span class="ticon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 17 6-6 4 4 8-8"></path><path d="M15 7h6v6"></path></svg></span>Calculadora de rentabilidad</a>
          <a href="/mediana" aria-current={sub("/mediana")}><span class="ticon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 20v-8M10 20V6M15 20v-9M20 20v-5"></path><path d="M3 12.5h18" stroke-dasharray="2 3"></path></svg></span>Calculadora de mediana</a>
          <a href="/tarjetas" aria-current={sub("/tarjetas")}><span class="ticon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="3"></rect><path d="M2.5 10h19M6.5 15h4"></path></svg></span>Guía de tarjetas</a>
        </div>
      </div>
      <a href="/apps" aria-current={current("apps")}>Apps</a>
      <a href="/equipo" aria-current={current("equipo")}>Equipo</a>
    </div>
    <a class="btn nav-cta" href="/asesorias"><span>Agendar<span class="label-long"> asesoría</span></span><span class="arrow" aria-hidden="true">→</span></a>
    <button class="menu-btn" id="nav-menu-btn" type="button" aria-label="Menú" aria-expanded="false" aria-controls="nav-links">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>
</nav>

<script>
  const btn = document.getElementById("nav-menu-btn");
  const links = document.getElementById("nav-links");
  btn?.addEventListener("click", () => {
    const open = links?.classList.toggle("open") ?? false;
    btn.setAttribute("aria-expanded", String(open));
  });
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap");
  :root {
    --bg: #ffffff;
    --surface: #f5f3f8;
    --fg: #3d2d53;
    --muted: #6c6279;
    --line: #e7e3ed;
    --mark: #ffd60a;
    --mark-ink: #3d2d53;
    --accent: #1fa85a;
    --accent-strong: #15803d;
    --accent-soft: #e2f4e9;
    --on-accent: #ffffff;
    --display: "Outfit", system-ui, -apple-system, sans-serif;
    --body: "Outfit", system-ui, -apple-system, sans-serif;
    --wrap: 1120px;
  }
</style>

<style>
  nav.top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    font: 500 16px/1.55 var(--body);
    color: var(--fg);
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
  }
  a { color: inherit; text-decoration: none; }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 17px var(--display);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand img { width: 30px; height: 30px; border-radius: 50%; }
  .links { display: flex; align-items: center; gap: 24px; font-size: 15px; color: var(--muted); }
  .links a:hover { color: var(--fg); }
  .links > a, .dd > a { position: relative; }
  .links a[aria-current="page"] { color: var(--fg); }
  .links > a[aria-current="page"]::after,
  .dd > a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 3px;
    border-radius: 3px;
    background: var(--accent);
  }
  .dd { position: relative; height: 64px; display: flex; align-items: center; }
  .dd-menu {
    position: absolute;
    top: 58px;
    left: -18px;
    width: 340px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 8px;
    box-shadow: 0 24px 48px -24px rgba(61, 45, 83, 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    display: grid;
  }
  .dd:hover .dd-menu, .dd:focus-within .dd-menu { opacity: 1; visibility: visible; transform: none; }
  .dd-menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 14px;
    color: var(--fg);
    font-weight: 600;
    font-size: 15px;
  }
  .dd-menu a:hover, .dd-menu a[aria-current="page"] { background: var(--surface); }
  .ticon {
    width: 34px;
    height: 34px;
    border-radius: 11px;
    background: var(--accent-soft);
    display: grid;
    place-items: center;
    flex: none;
  }
  .ticon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--accent-strong);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 15px;
    border-radius: 999px;
    padding: 6px 6px 6px 18px;
    background: var(--fg);
    color: var(--bg);
    white-space: nowrap;
  }
  .btn .arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--mark);
    color: var(--mark-ink);
    display: grid;
    place-items: center;
    transition: transform 0.2s ease;
  }
  .btn:hover .arrow { transform: translateX(3px); }
  .nav-cta { margin-left: auto; }
  .menu-btn {
    display: none;
    margin-left: 8px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
    place-items: center;
  }
  .menu-btn svg { width: 18px; height: 18px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }

  @media (max-width: 900px) {
    .links { display: none; }
    .menu-btn { display: grid; }
    .links.open {
      display: flex;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 8px 20px 20px;
      max-height: calc(100vh - 64px);
      overflow: auto;
      box-shadow: 0 24px 40px -24px rgba(27, 20, 38, 0.35);
    }
    .links.open > a, .links.open .dd > a {
      padding: 14px 4px;
      font-size: 17px;
      color: var(--fg);
      border-bottom: 1px solid var(--line);
    }
    .links.open a[aria-current="page"]::after { display: none; }
    .links.open .dd { height: auto; display: grid; width: 100%; grid-template-columns: minmax(0, 1fr); }
    .links.open .dd-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      width: auto;
      border: 0;
      box-shadow: none;
      padding: 4px 0 8px;
      background: transparent;
    }
    .links.open .dd-menu a { padding: 8px 4px; }
  }
  @media (max-width: 600px) {
    .nav-cta .label-long { display: none; }
  }
  @media (max-width: 480px) {
    .wrap { gap: 10px; }
    .brand { font-size: 16px; }
  }
</style>
