---
/**
 * Layout del rediseño: sin Tailwind, con los estilos de src/styles/rip.css.
 * Las páginas viejas siguen usando Layout.astro (Tailwind) con el mismo Navbar y Footer.
 */
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/rip.css";

interface Props {
  title: string;
  description?: string;
  /** Imagen para la vista previa al compartir (1200x675), ruta dentro de public/. */
  image?: string;
  currentPath?: string;
}

const {
  title,
  description = "Inspirando personas a mejorar sus finanzas",
  image,
  currentPath = Astro.url.pathname,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RIP Wallet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_CR" />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="675" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={imageUrl} />
        </>
      )
    }
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" />
    <slot name="head" />
  </head>
  <body>
    <Navbar currentPath={currentPath} />
    <slot />
    <Footer />
  </body>
</html>
